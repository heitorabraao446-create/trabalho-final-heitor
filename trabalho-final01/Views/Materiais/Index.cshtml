@model List<SistemaControleMateriaisWeb.Models.Material>

@{
    ViewData["Title"] = "Materiais";
}

@if (TempData["Mensagem"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensagem"]
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="text-danger">Materiais cadastrados</h1>

    <a asp-action="Create" class="btn btn-primary">
        Novo material
    </a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        Nenhum material foi cadastrado.
    </div>
}
else
{
    <table class="table table-striped table-bordered align-middle">
        <thead>
            <tr>
                <th class="text-danger">Id</th>
                <th class="text-danger">Nome</th>
                <th class="text-danger">Categoria</th>
                <th class="text-danger">Quantidade</th>
                <th class="text-danger">Estoque mínimo</th>
                <th class="text-danger">Ações</th>
            </tr>
        </thead>

        <tbody>
        @foreach (Material material in Model)
        {
            <tr>
                <td>@material.Id</td>
                <td>@material.Nome</td>
                <td>@material.Categoria</td>
                <td>@material.Quantidade</td>
                <td>@material.EstoqueMinimo</td>
                <td>
                    <a asp-controller="Materiais"
                        asp-action="Details"
                        asp-route-id="@material.Id"
                        class="btn btn-sm btn-info">
                            Detalhes
                    </a>    

                    <a asp-action="Edit"
                       asp-route-id="@material.Id"
                       class="btn btn-sm btn-warning">Editar</a>

                    <a asp-action="Delete"
                       asp-route-id="@material.Id"
                       class="btn btn-sm btn-danger">Excluir</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}